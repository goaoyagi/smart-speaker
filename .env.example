# Audio Devices
MIC_DEVICE=hw:0,0
SPEAKER_DEVICE=plughw:0,0

# Audio Recording
SAMPLE_RATE=16000
CHANNELS=1
RECORD_SECONDS=10

# Whisper Configuration
WHISPER_MODEL_SIZE=small

# Piper TTS Configuration
PIPER_MODEL_PATH=./models/piper/tsukuyomi.onnx
PIPER_CONFIG_PATH=./models/piper/tsukuyomi.onnx.json

# Status LED (GPIO) settings
STATUS_LED_ENABLED=true
STATUS_LED_PIN=23

# Push-to-talk (GPIO button) settings
PUSH_TO_TALK_ENABLED=true
PTT_BUTTON_PIN=24
PTT_BOUNCE_TIME=0.05
PTT_MIN_RECORD_SECONDS=0.5
PTT_MAX_RECORD_SECONDS=30

# Conversation history (multi-turn dialogue) settings
CONVERSATION_MAX_TURNS=5
CONVERSATION_ANSWER_CLIP=400

# Debug (optional: set to save recorded audio for analysis)
# DEBUG_AUDIO_DIR=./debug

# SearXNG Configuration
SEARXNG_URL=http://localhost:8080
SEARCH_CANDIDATE_LIMIT=10

# Reranker (Optimum/ONNX) settings — enabled by default; fails soft to raw search results
RERANKER_ENABLED=true
RERANKER_MODEL_ID=hotchpotch/japanese-reranker-cross-encoder-xsmall-v1
RERANKER_LOCAL_PATH=./models/reranker
RERANK_TOP_K=3
RERANK_MIN_SCORE=0.0

# Page fetch + passage reranking settings (retriever.py)
# 本文取得をオフにすると、現行のスニペット経路に戻る
FETCH_PAGE_ENABLED=true
FETCH_PAGE_TOP_N=3
FETCH_PAGE_TIMEOUT=3
PASSAGE_CHARS=250

# Ollama Configuration
# 既存の .env を使っている場合は /api/generate から /api/chat へ書き換える
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
CONTEXT_CHAR_BUDGET=2000
CHAR_TO_TOKEN_RATIO=1.0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.3
OLLAMA_REPEAT_PENALTY=1.1
# モデルをメモリに保持する時間。期間文字列（30m / 24h / 1800s）で指定する
OLLAMA_KEEP_ALIVE=30m
# 検索要否判定・クエリ書き換え（最終回答の前の補助呼び出し。失敗時は元の質問で検索）
QUERY_PREP_ENABLED=true
OLLAMA_AUX_NUM_PREDICT=64
OLLAMA_AUX_TEMPERATURE=0.0
