[Unit]
Description=AI Smart Speaker (push-to-talk voice assistant)
Documentation=https://github.com/goaoyagi/smart-speaker
After=network-online.target sound.target searxng.service ollama.service
Wants=network-online.target searxng.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
SupplementaryGroups=__SUPPLEMENTARY_GROUPS__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
__SEARXNG_URL_ENV__
ExecStart=__PYTHON_BIN__ -m src.main
# on-failure: without a GPIO button src.main records once and exits 0;
# restarting on success would keep recording without any button press.
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
